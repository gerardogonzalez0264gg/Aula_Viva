@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

Person(estudiante, "Estudiante")
Person(docente, "Docente")

System(aulaviva, "AulaViva", "Plataforma educativa con IA")

System_Ext(llm, "Servicio de IA", "Servicio externo de inteligencia artificial")

Rel(estudiante, aulaviva, "Utiliza")
Rel(docente, aulaviva, "Gestiona cursos y evaluaciones")
Rel(aulaviva, llm, "Consulta")
@enduml
